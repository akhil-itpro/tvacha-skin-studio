# Keep real values in .dev.vars (local) or Sites runtime secrets (hosted).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini's unpaid terms prohibit personal information. Only enable for a paid project.
GEMINI_DATA_POLICY=
# Free Groq vision setup: confirm Free plan and turn on ZDR in Groq Data Controls first.
PHOTO_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_ZDR_ENABLED=false
# Explicit server-side admin allowlists. Email comes from trusted platform sign-in.
ADMIN_USER_IDS=
ADMIN_EMAILS=
